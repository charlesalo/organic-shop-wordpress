# WordPress core — ignore everything at root, whitelist what we want
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php
/tmp/

# Database & uploads
wp-content/uploads/
*.sqlite
wp-content/db.php

# Third-party plugins & themes
wp-content/plugins/*
wp-content/themes/*
!wp-content/themes/verdant-harvest/

# OS & IDE
.DS_Store
.vscode/
node_modules/
.env